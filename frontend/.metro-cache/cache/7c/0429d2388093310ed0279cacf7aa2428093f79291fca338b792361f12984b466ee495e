he standard iOS modal dismissal animation (~330ms).\n      await new Promise(r => setTimeout(r, 400));\n      setPdfBusy(true);\n      try {\n        await (0, _srcPrintHtml.printReportHtml)(html, `${tool.name || \"for-sale\"}-poster-${Date.now()}`);\n      } catch (e) {\n        console.error(\"[poster] generation failed:\", e);\n        Alert.default.alert(\"Could not generate poster\", e?.message || String(e));\n      } finally {\n        setPdfBusy(false);\n      }\n    };\n    const doExportPdf = async (includeReceipts, includeExpansions = false) => {\n      const esc = s => String(s ?? \"\").replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\");\n      const fmtMoney = v => {\n        const n = Number(v);\n        return isFinite(n) ? `${(0, _srcCurrency.formatMoney)(n)}` : \"—\";\n      };\n\n      // ---- Bundle/set content (per report spec) -----------------------------\n      // Inside items are ALWAYS listed by name (and model) but NEVER with their\n      // individual pricing. Expansion (add-on) items are appended only when the\n      // user opted in, and DO show their individual prices + a subtotal.\n      const insideItems = tool.is_bundle && Array.isArray(tool.inside_items) ? tool.inside_items : [];\n      let expansionItems = [];\n      if (tool.is_bundle && includeExpansions) {\n        try {\n          expansionItems = (await _srcApi.api.listExpansionItems(tool.id, {\n            forceFresh: true\n          })) || [];\n        } catch {\n          expansionItems = [];\n        }\n      }\n      let bundleInsideHtml = \"\";\n      if (tool.is_bundle) {\n        const rowsH = insideItems.length ? insideItems.map(it => {\n          const model = it.model ? `&nbsp;&middot;&nbsp;<span style=\"color:#777;font-weight:normal\">${esc(it.model)}</span>` : \"\";\n          return `<tr><td>${esc(it.name) || \"(unnamed)\"}${model}</td></tr>`;\n        }).join(\"\") : `<tr><td style=\"color:#777\">No items added to this set yet.</td></tr>`;\n        bundleInsideHtml = `<table class=\"section-band\"><tr><td>ITEMS IN THIS SET${insideItems.length ? ` (${insideItems.length})` : \"\"}</td></tr></table>\n        <table class=\"setlist\">${rowsH}</table>`;\n      }\n      let bundleExpHtml = \"\";\n      if (tool.is_bundle && includeExpansions) {\n        if (expansionItems.length) {\n          const rowsH = expansionItems.map(it => {\n            const model = it.model || it.model_numbers && it.model_numbers[0] || \"\";\n            const modelHtml = model ? `&nbsp;&middot;&nbsp;<span style=\"color:#777;font-weight:normal\">${esc(model)}</span>` : \"\";\n            return `<tr><td>${esc(it.name) || \"(unnamed)\"}${modelHtml}</td><td class=\"amt\">${fmtMoney(it.cost)}</td></tr>`;\n          }).join(\"\");\n          const subtotal = expansionItems.reduce((s, i) => s + (Number(i.cost) || 0), 0);\n          bundleExpHtml = `<table class=\"section-band\"><tr><td>EXPANSION ITEMS (ADD-ONS)</td></tr></table>\n          <table class=\"setlist\">${rowsH}<tr class=\"subtot\"><td>SUBTOTAL</td><td class=\"amt\">${fmtMoney(subtotal)}</td></tr></table>`;\n        } else {\n          bundleExpHtml = `<table class=\"section-band\"><tr><td>EXPANSION ITEMS (ADD-ONS)</td></tr></table>\n          <table class=\"setlist\"><tr><td style=\"color:#777\">No expansion items linked to this set.</td></tr></table>`;\n        }\n      }\n\n      // Photos — compress and render up to 4 in a 2-up grid (xhtml2pdf-friendly).\n      // Compression is critical to prevent iOS WKWebView print pipeline hangs\n      // on large camera-quality photos.\n      const rawPhotos = (tool.photos || []).slice(0, 4);\n      const photoCells = await (0, _srcPdfImage.compressManyForPdf)(rawPhotos, {\n        maxWidth: 900,\n        quality: 0.6\n      });\n      const photosHtml = photoCells.length ? `<table class=\"photos\"><tr>${photoCells.slice(0, 2).map(p => `<td><img src=\"${p}\"/></td>`).join(\"\")}</tr>${photoCells.length > 2 ? `<tr>${photoCells.slice(2, 4).map(p => `<td><img src=\"${p}\"/></td>`).join(\"\")}</tr>` : \"\"}</table>` : \"\";\n      const history = (tool.checkout_history || []).map(h => `<tr><td>${esc(h.borrower_name)}</td><td>${esc((0, _srcDateUtil.formatDateUS)(h.checked_out_at))}</td><td>${esc((0, _srcDateUtil.formatDateUS)(h.checked_in_at))}</td></tr>`).join(\"\");\n      const rawReceipts = Array.isArray(tool.receipts) ? tool.receipts : [];\n      const receipts = includeReceipts && rawReceipts.length > 0 ? await (0, _srcPdfImage.compressManyForPdf)(rawReceipts, {\n        maxWidth: 1200,\n        quality: 0.6\n      }) : [];\n      // Header model #s (joined) for the receipt sub-line in PDFs.\n      const _pdfHeaderMns = Array.isArray(tool.model_numbers) && tool.model_numbers.length ? tool.model_numbers.filter(s => !!s) : tool.serial_number ? [String(tool.serial_number)] : [];\n      const _pdfHeaderMnsStr = _pdfHeaderMns.length ? _pdfHeaderMns.join(\", \") : \"—\";\n      const receiptPages = includeReceipts && receipts.length > 0 ? receipts.map((r, i) => `\n              <pdf:nextpage/>\n              <div class=\"rcpt-header\">RECEIPT ${i + 1} OF ${receipts.length}</div>\n              <div class=\"rcpt-sub\"><b>${esc(tool.name) || \"(unnamed)\"}</b> &middot; Model: <b>${esc(_pdfHeaderMnsStr)}</b></div>\n              <div class=\"rcpt-img-wrap\"><img class=\"rcpt-img\" src=\"${r}\"/></div>`).join(\"\") : \"\";\n      const _isLost = !!tool.lost_status?.is_lost;\n      const statusLabel = _isLost ? tool.lost_status?.type === \"stolen\" ? \"STOLEN\" : \"LOST\" : tool.is_sold ? \"SOLD\" : tool.is_checked_out ? \"CHECKED OUT\" : \"AVAILABLE\";\n      const statusColor = _isLost || tool.is_checked_out ? \"#dc2626\" : \"#16a34a\";\n      const statusBg = _isLost || tool.is_checked_out ? \"#fee2e2\" : \"#dcfce7\";\n\n      // Build spec rows (only show populated fields)\n      const specPairs = [];\n      if (tool.brand) specPairs.push({\n        label: \"Brand\",\n        value: String(tool.brand)\n      });\n      // 