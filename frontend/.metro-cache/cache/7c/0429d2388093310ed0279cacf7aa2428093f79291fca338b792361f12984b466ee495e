nd-color: #DC2626;\n    padding: 0 12pt 10pt 12pt;\n  }\n  table.contact-inner {\n    width: 100%;\n    background-color: #FFFFFF;\n    border: 2pt solid #000000;\n  }\n  td.contact-line-bold {\n    text-align: center;\n    font-size: 14pt;\n    font-weight: bold;\n    color: #000000;\n    padding: 6pt 8pt 1pt 8pt;\n    text-transform: uppercase;\n    letter-spacing: 1pt;\n  }\n  td.contact-line {\n    text-align: center;\n    font-size: 11pt;\n    color: #000000;\n    padding: 1pt 8pt;\n  }\n  td.contact-line-pad-bottom {\n    padding-bottom: 6pt;\n  }\n\n  /* === FOOTER (centered wordmark on the white page area) === */\n  table.poster-footer { width: 100%; margin-top: 14pt; }\n  table.poster-footer td { border: 0; vertical-align: middle; }\n  td.pf-side { color: #888888; font-size: 7pt; letter-spacing: 2pt; }\n  td.pf-l { width: 50%; text-align: right; }\n  td.pf-r { width: 50%; text-align: left; }\n  td.pf-logo { text-align: center; white-space: nowrap; }\n</style>\n</head>\n<body>\n\n  <!-- TOP RED BANNER -->\n  <table class=\"top-banner\"><tr><td class=\"top-banner-cell\">FOR SALE</td></tr></table>\n\n  ${F.name ? `<table class=\"name-band\"><tr><td class=\"name-text\">${esc(tool.name) || \"(UNNAMED)\"}</td></tr></table>` : \"\"}\n\n  <!-- PHOTO LEFT, SPECS RIGHT -->\n  <table class=\"photo-specs\"><tr>\n    <td class=\"photo-cell\">${heroPhoto ? `<img class=\"hero-photo\" src=\"${heroPhoto}\"/>` : `<div style=\"width: 3.4in; height: 3.4in; border: 2pt solid #000000; background-color: #f0f0f0;\">&nbsp;</div>`}</td>\n    <td class=\"specs-cell\">\n      <table class=\"specs-list\">\n        ${specRows.map(r => `\n              <tr>\n                <td class=\"spec-lab\">${esc(r.label).toUpperCase()}:</td>\n                <td class=\"spec-val\">${esc(r.value) || \"&nbsp;\"}</td>\n              </tr>`).join(\"\")}\n      </table>\n    </td>\n  </tr></table>\n\n  ${F.price ? `<table class=\"price-prompt\"><tr><td class=\"price-prompt-cell\">ASKING PRICE: $${askin