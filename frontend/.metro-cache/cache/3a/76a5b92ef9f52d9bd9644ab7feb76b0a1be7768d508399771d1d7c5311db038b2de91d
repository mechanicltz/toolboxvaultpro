ckups/restore-from-drive`, {\n        method: \"POST\",\n        headers: token ? {\n          Authorization: `Bearer ${token}`\n        } : undefined,\n        body: form\n      });\n      const data = await res.json().catch(() => ({}));\n      if (!res.ok) throw new Error(data?.detail || `Server ${res.status}`);\n      return data;\n    },\n    // Verify a backup file (no DB writes). Accepts a local file uri + passphrase.\n    adminVerifyBackup: async (fileUri, fileName, passphrase) => {\n      const token = await getToken();\n      const form = new FormData();\n      form.append(\"file\", {\n        uri: fileUri,\n        name: fileName,\n        type: \"application/zip\"\n      });\n      if (passphrase) form.append(\"passphrase\", passphrase);\n      const res = await fetch(`${API_BASE}/api/admin/backups/verify`, {\n        method: \"POST\",\n        headers: token ? {\n          Authorization: `Bearer ${token}`\n        } : undefined,\n        body: form\n      });\n      const data = await res.json().catch(() => ({}));\n      if (!res.ok) throw new Error(data?.detail || `Server ${res.status}`);\n      return data;\n    },\n    // Test-restore a backup into a throwaway sandbox DB (production untouched).\n    adminTestSandbox: async (fileUri, fileName, passphrase) => {\n      const token = await getToken();\n      const form = new FormData();\n      form.append(\"file\", {\n        uri: fileUri,\n        name: fileName,\n        type: \"application/zip\"\n      });\n      if (passphrase) form.append(\"passphrase\", passphrase);\n      const res = await fetch(`${API_BASE}/api/admin/backups/test-sandbox`, {\n        method: \"POST\",\n        headers: token ? {\n          Authorization: `Bearer ${token}`\n        } : undefined,\n        body: form\n      });\n      const data = await res.json().catch(() => ({}));\n      if (!res.ok) throw new Error(data?.detail || `Server ${res.status}`);\n      return data;\n    },\n    // ---- Bootstrap (public, only works on a