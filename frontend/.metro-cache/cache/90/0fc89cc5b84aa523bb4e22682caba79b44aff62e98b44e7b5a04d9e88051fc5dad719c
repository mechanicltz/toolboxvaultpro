top: 14pt; }\n  table.poster-footer td { border: 0; vertical-align: middle; }\n  td.pf-side { color: #888888; font-size: 7pt; letter-spacing: 2pt; }\n  td.pf-l { width: 50%; text-align: right; }\n  td.pf-r { width: 50%; text-align: left; }\n  td.pf-logo { text-align: center; white-space: nowrap; }\n</style>\n</head>\n<body>\n\n  <!-- TOP RED BANNER -->\n  <table class=\"top-banner\"><tr><td class=\"top-banner-cell\">FOR SALE</td></tr></table>\n\n  ${F.name ? `<table class=\"name-band\"><tr><td class=\"name-text\">${esc(tool.name) || \"(UNNAMED)\"}</td></tr></table>` : \"\"}\n\n  <!-- PHOTO LEFT, SPECS RIGHT -->\n  <table class=\"photo-specs\"><tr>\n    <td class=\"photo-cell\">${heroPhoto ? `<img class=\"hero-photo\" src=\"${heroPhoto}\"/>` : `<div style=\"width: 3.4in; height: 3.4in; border: 2pt solid #000000; background-color: #f0f0f0;\">&nbsp;</div>`}</td>\n    <td class=\"specs-cell\">\n      <table class=\"specs-list\">\n        ${specRows.map(r => `\n              <tr>\n                <td class=\"spec-lab\">${esc(r.label).toUpperCase()}:</td>\n                <td class=\"spec-val\">${esc(r.value) || \"&nbsp;\"}</td>\n              </tr>`).join(\"\")}\n      </table>\n    </td>\n  </tr></table>\n\n  ${F.price ? `<table class=\"price-prompt\"><tr><td class=\"price-prompt-cell\">ASKING PRICE: $${askingPrice}</td></tr></table>` : \"\"}\n\n  ${F.description ? `<table class=\"desc-band\"><tr><td class=\"desc-text\"><b>DESCRIPTION:</b> ${tool.description ? esc(tool.description) : \"&nbsp;\"}</td></tr></table>` : \"\"}\n\n  ${F.sale_notes ? `<table class=\"desc-band\"><tr><td class=\"desc-text\"><b>NOTES:</b> ${tool.sale_notes ? esc(tool.sale_notes) : \"&nbsp;\"}</td></tr></table>` : \"\"}\n\n  ${contactLines.length ? `<table class=\"bot-banner\"><tr><td class=\"bot-banner-cell\">FOR INQUIRIES PLEASE CONTACT</td></tr></table>\n         <table class=\"contact-box\"><tr><td class=\"contact-cell\">\n           <table class=\"contact-inner\">\n             ${contactLines