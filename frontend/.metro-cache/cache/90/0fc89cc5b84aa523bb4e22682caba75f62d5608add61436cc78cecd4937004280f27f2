ce ? `<table class=\"price-prompt\"><tr><td class=\"price-prompt-cell\">ASKING PRICE: $${askingPrice}</td></tr></table>` : \"\"}\n\n  ${F.description ? `<table class=\"desc-band\"><tr><td class=\"desc-text\"><b>DESCRIPTION:</b> ${tool.description ? esc(tool.description) : \"&nbsp;\"}</td></tr></table>` : \"\"}\n\n  ${F.sale_notes ? `<table class=\"desc-band\"><tr><td class=\"desc-text\"><b>NOTES:</b> ${tool.sale_notes ? esc(tool.sale_notes) : \"&nbsp;\"}</td></tr></table>` : \"\"}\n\n  ${contactLines.length ? `<table class=\"bot-banner\"><tr><td class=\"bot-banner-cell\">FOR INQUIRIES PLEASE CONTACT</td></tr></table>\n         <table class=\"contact-box\"><tr><td class=\"contact-cell\">\n           <table class=\"contact-inner\">\n             ${contactLines.map((c, i) => {\n        const isLast = i === contactLines.length - 1;\n        const padBottom = isLast ? \" contact-line-pad-bottom\" : \"\";\n        if (c.bold) {\n          return `<tr><td class=\"contact-line-bold${padBottom}\">${c.value ? esc(c.value) : \"&nbsp;\"}</td></tr>`;\n        }\n        const labelPart = c.label ? `<b>${c.label}:</b> ` : \"\";\n        return `<tr><td class=\"contact-line${padBottom}\">${labelPart}${c.value ? esc(c.value) : \"&nbsp;\"}</td></tr>`;\n      }).join(\"\")}\n           </table>\n           <div class=\"footer-inline\">LISTED VIA TOOLBOX VAULT &nbsp;&middot;&nbsp; ${new Date().toLocaleDateString()}</div>\n         </td></tr></table>` : `<div class=\"footer-inline\" style=\"color:#888; padding-top: 14pt;\">LISTED VIA TOOLBOX VAULT &nbsp;&middot;&nbsp; ${new Date().toLocaleDateString()}</div>`}\n\n</body>\n</html>`;\n      setShowPosterBuilder(false);\n      // Wait for the Poster Builder Modal to fully dismiss before invoking\n      // expo-print. iOS only allows one presented view controller at a time —\n      // calling Print.printToFileAsync mid-dismiss will hang silently. The\n      // 400ms wait covers the standard iOS modal dismissal animation (~330ms).\n      aw